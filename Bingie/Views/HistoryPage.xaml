<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Bingie.Views.Components"
             x:Class="Bingie.Views.HistoryPage"
             Title="History">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1F1C2C" Offset="0" />
                <GradientStop Color="#928DAB" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">
                <Frame BackgroundColor="#FAFAFE"
                       CornerRadius="24"
                       HasShadow="True"
                       Padding="20">
                    <Frame.Shadow>
                        <Shadow Offset="8,8"
                                Radius="20"
                                Brush="#1B1B2F"
                                Opacity="0.35" />
                    </Frame.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Monthly reflection"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#2A2D43" />
                        <Label x:Name="SummaryCountLabel"
                               Text="Logged moments this month:"
                               FontSize="18"
                               TextColor="#43455C" />
                        <Label x:Name="SummaryStreakLabel"
                               Text="Current break:"
                               FontSize="16"
                               TextColor="#686A8B" />
                    </VerticalStackLayout>
                </Frame>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <Button Text="◀ Previous"
                            Clicked="OnPreviousMonthClicked"
                            CornerRadius="18"
                            BackgroundColor="#272A43"
                            TextColor="White"
                            HeightRequest="44" />
                    <Button Grid.Column="1"
                            Text="Next ▶"
                            Clicked="OnNextMonthClicked"
                            CornerRadius="18"
                            BackgroundColor="#272A43"
                            TextColor="White"
                            HeightRequest="44" />
                </Grid>

                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsVisible="False"
                                   IsRunning="False"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                <Border StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 24"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Offset="6,6"
                                Radius="20"
                                Brush="#1B1B2F"
                                Opacity="0.25" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="CurrentDateLabel"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#2D325A"
                               HorizontalOptions="Center" />
                        <components:CalendarView x:Name="CalendarView"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Start"
                                                 Margin="0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Button x:Name="ToggleAnalyticsButton"
                            Text="Show trend insights"
                            Clicked="OnToggleAnalyticsClicked"
                            CornerRadius="18"
                            BackgroundColor="#F7F7FF"
                            TextColor="#2A2D43" />
                    <ContentView x:Name="AnalyticsContent" IsVisible="False">
                        <VerticalStackLayout Spacing="14">
                            <GraphicsView x:Name="BingeChartView"
                                          HeightRequest="240" />
                            <CollectionView x:Name="AnalyticsCollectionView"
                                            SelectionMode="None"
                                            ItemsLayout="VerticalList">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeThickness="0"
                                                BackgroundColor="#FFFFFF"
                                                Margin="0,4"
                                                Padding="12"
                                                StrokeShape="RoundRectangle 16">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout>
                                                    <Label Text="{Binding DayDisplay}"
                                                           FontSize="18"
                                                           TextColor="#303555"
                                                           FontAttributes="Bold" />
                                                    <Label Text="{Binding Summary}"
                                                           FontSize="14"
                                                           TextColor="#666A8C" />
                                                </VerticalStackLayout>
                                                <Label Text="{Binding CountDisplay}"
                                                       FontSize="24"
                                                       TextColor="#FF6B6B"
                                                       FontAttributes="Bold"
                                                       Grid.Column="1"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </ContentView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
