<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingie.Views.HistoryPage"
             Title="History"
             BackgroundColor="{x:Static graphics:Colors.WhiteSmoke}"
             xmlns:graphics="clr-namespace:Microsoft.Maui.Graphics;assembly=Microsoft.Maui.Graphics">

    <Grid RowDefinitions="Auto,*" Padding="20">
        <!-- Header -->
        <StackLayout Grid.Row="0" Spacing="15" Margin="0,10,0,20">
            <Label Text="Your History"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{x:Static graphics:Colors.DarkSlateGray}"
                   HorizontalOptions="Start" />

            <Label Text="Track your progress over time"
                   FontSize="16"
                   TextColor="{x:Static graphics:Colors.Gray}"
                   HorizontalOptions="Start"
                   Margin="0,-10,0,0" />
        </StackLayout>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <StackLayout Spacing="20">
                <!-- Week Navigation -->
                <Frame BackgroundColor="{x:Static graphics:Colors.White}"
                       CornerRadius="15"
                       HasShadow="True"
                       Padding="15">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <Button Grid.Column="0" Grid.Row="0"
                                Text="←"
                                FontSize="20"
                                FontAttributes="Bold"
                                BackgroundColor="{x:Static graphics:Colors.LightGray}"
                                TextColor="{x:Static graphics:Colors.DarkGray}"
                                CornerRadius="10"
                                HeightRequest="50"
                                WidthRequest="50"
                                Clicked="OnPreviousWeekClicked" />

                        <StackLayout Grid.Column="1" Grid.Row="0"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                            <Label x:Name="WeekNumberLabel"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{x:Static graphics:Colors.DarkSlateGray}"
                                   HorizontalOptions="Center" />
                            <Label x:Name="DateRangeLabel"
                                   FontSize="14"
                                   TextColor="{x:Static graphics:Colors.Gray}"
                                   HorizontalOptions="Center" />
                        </StackLayout>

                        <Button Grid.Column="2" Grid.Row="0"
                                Text="→"
                                FontSize="20"
                                FontAttributes="Bold"
                                BackgroundColor="{x:Static graphics:Colors.LightGray}"
                                TextColor="{x:Static graphics:Colors.DarkGray}"
                                CornerRadius="10"
                                HeightRequest="50"
                                WidthRequest="50"
                                Clicked="OnNextWeekClicked" />

                        <Button Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                Text="Today's Statistics"
                                FontAttributes="Bold"
                                BackgroundColor="{x:Static graphics:Colors.DeepSkyBlue}"
                                TextColor="{x:Static graphics:Colors.White}"
                                CornerRadius="10"
                                Margin="0,15,0,0"
                                Clicked="OnShowCurrentDayStatsClicked" />
                    </Grid>
                </Frame>

                <!-- Calendar -->
                <Frame BackgroundColor="{x:Static graphics:Colors.White}"
                       CornerRadius="15"
                       HasShadow="True"
                       Padding="15">
                    <StackLayout>
                        <Label Text="Weekly Calendar"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{x:Static graphics:Colors.DarkSlateGray}"
                               Margin="0,0,0,15" />

                        <!-- Day of Week Headers -->
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,0,0,10">
                            <Label Text="Sun" Grid.Column="0" HorizontalOptions="Center" TextColor="{x:Static graphics:Colors.Gray}" FontSize="14" />
                            <Label Text="Mon" Grid.Column="1" HorizontalOptions="Center" TextColor="{x:Static graphics:Colors.Gray}" FontSize="14" />
                            <Label Text="Tue" Grid.Column="2" HorizontalOptions="Center" TextColor="{x:Static graphics:Colors.Gray}" FontSize="14" />
                            <Label Text="Wed" Grid.Column="3" HorizontalOptions="Center" TextColor="{x:Static graphics:Colors.Gray}" FontSize="14" />
                            <Label Text="Thu" Grid.Column="4" HorizontalOptions="Center" TextColor="{x:Static graphics:Colors.Gray}" FontSize="14" />
                            <Label Text="Fri" Grid.Column="5" HorizontalOptions="Center" TextColor="{x:Static graphics:Colors.Gray}" FontSize="14" />
                            <Label Text="Sat" Grid.Column="6" HorizontalOptions="Center" TextColor="{x:Static graphics:Colors.Gray}" FontSize="14" />
                        </Grid>

                        <!-- Calendar Grid -->
                        <Grid x:Name="CalendarGrid"
                              RowDefinitions="Auto"
                              ColumnDefinitions="*,*,*,*,*,*,*"
                              RowSpacing="10"
                              ColumnSpacing="5">
                            <!-- Calendar days will be added here programmatically -->
                        </Grid>
                    </StackLayout>
                </Frame>

                <!-- Monthly Summary -->
                <Frame BackgroundColor="{x:Static graphics:Colors.White}"
                       CornerRadius="15"
                       HasShadow="True"
                       Padding="15">
                    <StackLayout>
                        <Label Text="Monthly Summary"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{x:Static graphics:Colors.DarkSlateGray}"
                               Margin="0,0,0,15" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="15" ColumnSpacing="15">
                            <!-- Total Episodes -->
                            <Frame Grid.Row="0" Grid.Column="0"
                                   BackgroundColor="{x:Static graphics:Colors.LightGray}"
                                   CornerRadius="10"
                                   Padding="15"
                                   HasShadow="False">
                                <StackLayout>
                                    <Label Text="Total Episodes"
                                           FontSize="14"
                                           TextColor="{x:Static graphics:Colors.Gray}" />
                                    <Label x:Name="TotalEpisodesLabel"
                                           Text="0"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="{x:Static graphics:Colors.DarkSlateGray}" />
                                </StackLayout>
                            </Frame>

                            <!-- Average Per Day -->
                            <Frame Grid.Row="0" Grid.Column="1"
                                   BackgroundColor="{x:Static graphics:Colors.LightGray}"
                                   CornerRadius="10"
                                   Padding="15"
                                   HasShadow="False">
                                <StackLayout>
                                    <Label Text="Daily Average"
                                           FontSize="14"
                                           TextColor="{x:Static graphics:Colors.Gray}" />
                                    <Label x:Name="AveragePerDayLabel"
                                           Text="0"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="{x:Static graphics:Colors.DarkSlateGray}" />
                                </StackLayout>
                            </Frame>

                            <!-- Most Active Day -->
                            <Frame Grid.Row="1" Grid.Column="0"
                                   BackgroundColor="{x:Static graphics:Colors.LightGray}"
                                   CornerRadius="10"
                                   Padding="15"
                                   HasShadow="False">
                                <StackLayout>
                                    <Label Text="Most Active Day"
                                           FontSize="14"
                                           TextColor="{x:Static graphics:Colors.Gray}" />
                                    <Label x:Name="MostActiveDayLabel"
                                           Text="-"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="{x:Static graphics:Colors.DarkSlateGray}" />
                                </StackLayout>
                            </Frame>

                            <!-- Progress -->
                            <Frame Grid.Row="1" Grid.Column="1"
                                   BackgroundColor="{x:Static graphics:Colors.LightGray}"
                                   CornerRadius="10"
                                   Padding="15"
                                   HasShadow="False">
                                <StackLayout>
                                    <Label Text="Trend"
                                           FontSize="14"
                                           TextColor="{x:Static graphics:Colors.Gray}" />
                                    <Label x:Name="TrendLabel"
                                           Text="-"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           TextColor="#343a40" />
                                </StackLayout>
                            </Frame>
                        </Grid>
                    </StackLayout>
                </Frame>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>