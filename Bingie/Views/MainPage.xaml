<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingie.Views.MainPage"
             BackgroundColor="#f8f9fa">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,10,0,20">
            <StackLayout Grid.Column="0" VerticalOptions="Center">
                <Label Text="Bingie"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#343a40" />
                <Label Text="Track your progress"
                       FontSize="16"
                       TextColor="#6c757d" />
            </StackLayout>

            <Frame Grid.Column="1"
                   BackgroundColor="#e9ecef"
                   CornerRadius="10"
                   Padding="15,10"
                   HasShadow="True">
                <Label x:Name="CurrentTimeLabel"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#495057"
                       HorizontalOptions="Center" />
            </Frame>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto">
            <!-- Button Area -->
            <Frame Grid.Row="0"
                   BackgroundColor="White"
                   CornerRadius="20"
                   Margin="0,10,0,20"
                   HasShadow="True"
                   VerticalOptions="FillAndExpand">
                <Grid RowDefinitions="*,Auto">
                    <Button Grid.Row="0"
                            Text="I Binged"
                            FontSize="28"
                            FontAttributes="Bold"
                            BackgroundColor="#dc3545"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Clicked="OnBingeButtonClicked"
                            WidthRequest="220"
                            HeightRequest="220"
                            CornerRadius="110"
                            Margin="0,20,0,10">
                        <Button.Shadow>
                            <Shadow Brush="#6c757d" Opacity="0.5" Offset="3,3" Radius="15" />
                        </Button.Shadow>
                    </Button>

                    <Label Grid.Row="1"
                           x:Name="BingeCountLabel"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="#343a40"
                           Margin="0,10,0,20" />
                </Grid>
            </Frame>

            <!-- Today's Progress -->
            <Frame Grid.Row="1"
                   BackgroundColor="White"
                   CornerRadius="15"
                   Margin="0,0,0,20"
                   Padding="20"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="Today's Progress"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#343a40"
                           Margin="0,0,0,10" />

                    <Frame BackgroundColor="#f8f9fa"
                           CornerRadius="10"
                           Padding="15"
                           HasShadow="False"
                           BorderColor="#dee2e6">
                        <StackLayout x:Name="DotsContainer"
                                     Orientation="Horizontal"
                                     HorizontalOptions="Center"
                                     Spacing="10" />
                    </Frame>
                </StackLayout>
            </Frame>

            <!-- Motivation Quote -->
            <Frame Grid.Row="2"
                   BackgroundColor="#4dabf7"
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <StackLayout>
                    <Label Text="Daily Motivation"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label x:Name="MotivationLabel"
                           Text="Every day is a new beginning. Take a deep breath and start again."
                           FontSize="14"
                           TextColor="White"
                           FontAttributes="Italic" />
                </StackLayout>
            </Frame>
        </Grid>

        <!-- Footer -->
        <Label Grid.Row="2"
               Text="Tap the button whenever you experience a binge episode"
               FontSize="13"
               TextColor="#6c757d"
               HorizontalOptions="Center"
               Margin="0,20,0,0" />
    </Grid>
</ContentPage>