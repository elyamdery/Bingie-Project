<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingie.Views.MainPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#10002B" Offset="0" />
                <GradientStop Color="#6A0DAD" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <StackLayout Padding="24" Spacing="18">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="4">
                <Label Text="Bingie"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label x:Name="CurrentTimeLabel"
                       FontSize="18"
                       TextColor="#E4E7FF" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="#21305B"
                    StrokeThickness="0"
                    Padding="16"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="UserNameLabel"
                               Text="Traveler"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label x:Name="UserLevelLabel"
                               Grid.Column="1"
                               FontSize="14"
                               TextColor="#E6F4FF"
                               HorizontalOptions="End" />
                    </Grid>
                    <Label x:Name="UserXpLabel"
                           FontSize="12"
                           TextColor="#C7D3FF" />
                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="End">
                        <Button x:Name="SettingsButton"
                                Text="Settings"
                                HeightRequest="32"
                                WidthRequest="92"
                                CornerRadius="16"
                                BackgroundColor="#323B75"
                                TextColor="White"
                                Clicked="OnSettingsButtonClicked" />
                        <Button x:Name="SignOutButton"
                                Text="Sign out"
                                HeightRequest="32"
                                WidthRequest="88"
                                CornerRadius="16"
                                BackgroundColor="#E84545"
                                TextColor="White"
                                Clicked="OnSignOutClicked" />
                    </HorizontalStackLayout>
                    <Border x:Name="SettingsContainer"
                            IsVisible="False"
                            BackgroundColor="#151C3D"
                            StrokeThickness="0"
                            Padding="12"
                            Margin="0,8,0,0"
                            StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Quick settings"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#F2F8FF" />
                            <HorizontalStackLayout Spacing="12"
                                                   HorizontalOptions="Fill">
                                <Label Text="Avatar feedback"
                                       TextColor="#C7D3FF"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Switch x:Name="AvatarFeatureSwitch"
                                        HorizontalOptions="End"
                                        Toggled="OnAvatarFeatureSwitchToggled" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="12"
                                                   HorizontalOptions="Fill">
                                <Label Text="Story guide"
                                       TextColor="#C7D3FF"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Switch x:Name="StoryFeatureSwitch"
                                        HorizontalOptions="End"
                                        Toggled="OnStoryFeatureSwitchToggled" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="12"
                                                   HorizontalOptions="Fill">
                                <Label Text="Points system"
                                       TextColor="#C7D3FF"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Switch x:Name="PointsFeatureSwitch"
                                        HorizontalOptions="End"
                                        Toggled="OnPointsFeatureSwitchToggled" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="12"
                                                   HorizontalOptions="Fill">
                                <Label Text="Trigger radar"
                                       TextColor="#C7D3FF"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Switch x:Name="TriggerRadarFeatureSwitch"
                                        HorizontalOptions="End"
                                        Toggled="OnTriggerRadarFeatureSwitchToggled" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="12"
                                                   HorizontalOptions="Fill">
                                <Label Text="Friends leaderboard"
                                       TextColor="#C7D3FF"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Switch x:Name="LeaderboardFeatureSwitch"
                                        HorizontalOptions="End"
                                        Toggled="OnLeaderboardFeatureSwitchToggled" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="12"
                                                   HorizontalOptions="Fill">
                                <Label Text="Legacy mode"
                                       TextColor="#C7D3FF"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Switch x:Name="LegacyModeSwitch"
                                        HorizontalOptions="End"
                                        Toggled="OnLegacyModeSwitchToggled" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <VerticalStackLayout x:Name="AvatarFeedbackSection"
                              Spacing="8"
                              Margin="0,4,0,12"
                              IsVisible="False">
            <Frame x:Name="AvatarBackgroundFrame"
                   Padding="18"
                   CornerRadius="18"
                   HasShadow="True"
                   BackgroundColor="#222845">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="AvatarEnergyTitle"
                           Text="Avatar energy"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label x:Name="AvatarScoreLabel"
                           FontSize="14"
                           TextColor="#E5E7FE" />
                    <Label x:Name="AvatarMonthlyLabel"
                           FontSize="14"
                           TextColor="#E5E7FE" />
                    <Label x:Name="AvatarBreakLabel"
                           FontSize="12"
                           TextColor="#C7CFFC" />
                    <Label x:Name="AvatarSupportiveCopy"
                           FontSize="14"
                           TextColor="White"
                           LineBreakMode="WordWrap" />
                    <Label x:Name="AvatarAnimationKeyLabel"
                           FontSize="12"
                           TextColor="#AEB6FF"
                           HorizontalOptions="End" />
                    <Frame x:Name="AvatarCelebrationBadge"
                           IsVisible="False"
                           Padding="6,2"
                           CornerRadius="12"
                           HasShadow="False"
                           BackgroundColor="#6E7BFF"
                           HorizontalOptions="Start"
                           Margin="0,6,0,0">
                        <Label Text="Monthly glow up"
                               FontSize="12"
                               TextColor="White" />
                    </Frame>
                </VerticalStackLayout>
            </Frame>
            <StackLayout Orientation="Horizontal"
                         Spacing="8"
                         HorizontalOptions="Center">
                <Label Text="Show avatar feedback"
                       FontSize="14"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Switch x:Name="AvatarFeedbackToggle"
                        Toggled="OnAvatarToggleToggled" />
            </StackLayout>
        </VerticalStackLayout>
        <Button x:Name="BingeButton"
                Text="I Binged"
                FontSize="24"
                BackgroundColor="Red"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="CenterAndExpand"
                Clicked="OnBingeButtonClicked"
                WidthRequest="200"
                HeightRequest="200"
                CornerRadius="100"
                Padding="10">
            <Button.Shadow>
                <Shadow Brush="Black" Opacity="0.5" Offset="5,5" Radius="10" />
            </Button.Shadow>
        </Button>

        <Label x:Name="FeedbackLabel"
               Opacity="0"
               Text=""
               FontSize="18"
               HorizontalOptions="Center"
               TextColor="White"
               Margin="0,12,0,0" />

        <Frame Margin="0,20,0,20"
               BorderColor="Black"
               HorizontalOptions="Center"
               VerticalOptions="CenterAndExpand">
            <StackLayout x:Name="DotsContainer"
                         Orientation="Vertical"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Padding="5" />
        </Frame>
        </StackLayout>
    </Grid>
</ContentPage>
