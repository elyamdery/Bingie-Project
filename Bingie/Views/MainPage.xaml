<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingie.Views.MainPage">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#10002B" Offset="0" />
                <GradientStop Color="#6A0DAD" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <StackLayout Padding="24" Spacing="18">
        <VerticalStackLayout x:Name="AvatarFeedbackSection"
                              Spacing="8"
                              Margin="0,4,0,12"
                              IsVisible="False">
            <Frame x:Name="AvatarBackgroundFrame"
                   Padding="18"
                   CornerRadius="18"
                   HasShadow="True"
                   BackgroundColor="#222845">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="AvatarEnergyTitle"
                           Text="Avatar energy"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label x:Name="AvatarScoreLabel"
                           FontSize="14"
                           TextColor="#E5E7FE" />
                    <Label x:Name="AvatarMonthlyLabel"
                           FontSize="14"
                           TextColor="#E5E7FE" />
                    <Label x:Name="AvatarBreakLabel"
                           FontSize="12"
                           TextColor="#C7CFFC" />
                    <Label x:Name="AvatarSupportiveCopy"
                           FontSize="14"
                           TextColor="White"
                           LineBreakMode="WordWrap" />
                    <Label x:Name="AvatarAnimationKeyLabel"
                           FontSize="12"
                           TextColor="#AEB6FF"
                           HorizontalOptions="End" />
                    <Frame x:Name="AvatarCelebrationBadge"
                           IsVisible="False"
                           Padding="6,2"
                           CornerRadius="12"
                           HasShadow="False"
                           BackgroundColor="#FF8FAB"
                           HorizontalOptions="Start"
                           Margin="0,6,0,0">
                        <Label Text="Monthly glow up"
                               FontSize="12"
                               TextColor="White" />
                    </Frame>
                </VerticalStackLayout>
            </Frame>
            <StackLayout Orientation="Horizontal"
                         Spacing="8"
                         HorizontalOptions="Center">
                <Label Text="Show avatar feedback"
                       FontSize="14"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Switch x:Name="AvatarFeedbackToggle"
                        Toggled="OnAvatarToggleToggled" />
            </StackLayout>
        </VerticalStackLayout>
        <Label Text="Bingie"
               FontSize="36"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,20,0,0"
               TextColor="White" />

        <Label x:Name="CurrentTimeLabel"
               FontSize="18"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,10,0,20"
               TextColor="White" />

        <Button x:Name="BingeButton"
                Text="I Binged"
                FontSize="24"
                BackgroundColor="Red"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="CenterAndExpand"
                Clicked="OnBingeButtonClicked"
                WidthRequest="200"
                HeightRequest="200"
                CornerRadius="100"
                Padding="10">
            <Button.Shadow>
                <Shadow Brush="Black" Opacity="0.5" Offset="5,5" Radius="10" />
            </Button.Shadow>
        </Button>

        <Label x:Name="FeedbackLabel"
               Opacity="0"
               Text=""
               FontSize="18"
               HorizontalOptions="Center"
               TextColor="White"
               Margin="0,12,0,0" />

        <Frame Margin="0,20,0,20"
               BorderColor="Black"
               HorizontalOptions="Center"
               VerticalOptions="CenterAndExpand">
            <StackLayout x:Name="DotsContainer"
                         Orientation="Vertical"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Padding="5" />
        </Frame>
        </StackLayout>
    </Grid>
</ContentPage>
