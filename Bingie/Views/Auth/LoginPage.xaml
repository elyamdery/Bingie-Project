<?xml version="1.0" encoding="utf-8"?>

<!-- Views/Auth/LoginPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingie.Views.Auth.LoginPage"
             BackgroundColor="#101431">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#101431" Offset="0" />
                <GradientStop Color="#1F3A93" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="28" Spacing="24" VerticalOptions="Center">
                <Label Text="Welcome back"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />

                <Label Text="Log what happened and keep moving gently forward."
                       FontSize="16"
                       TextColor="#C7D0FF"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Frame Padding="22" CornerRadius="20" BackgroundColor="#FFFFFF" HasShadow="True">
                    <VerticalStackLayout Spacing="16">
                        <Entry x:Name="UsernameEntry"
                               Placeholder="Email or username"
                               Keyboard="Email"
                               ClearButtonVisibility="WhileEditing" />

                        <Entry x:Name="PasswordEntry"
                               Placeholder="Password"
                               IsPassword="True"
                               ClearButtonVisibility="WhileEditing" />

                        <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                            <CheckBox x:Name="RememberMeCheckBox" VerticalOptions="Center" />
                            <Label Text="Stay signed in"
                                   Grid.Column="1"
                                   VerticalOptions="Center"
                                   TextColor="#47527A" />
                        </Grid>

                        <Button x:Name="LoginButton"
                                Text="Sign in"
                                HeightRequest="48"
                                CornerRadius="16"
                                BackgroundColor="#1F3A93"
                                TextColor="White"
                                Clicked="OnLoginClicked" />

                        <Button Text="Create an account"
                                HeightRequest="48"
                                CornerRadius="16"
                                BackgroundColor="Transparent"
                                TextColor="#1F3A93"
                                BorderColor="#1F3A93"
                                BorderWidth="1"
                                Clicked="OnRegisterClicked" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="You are doing enough. Logging in is a win."
                       FontSize="14"
                       TextColor="#AAB4E0"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
