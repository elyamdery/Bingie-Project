<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingie.Views.Auth.LoginPage"
             BackgroundColor="#f5f5f5">
    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <!-- Header -->
        <StackLayout Grid.Row="0" Margin="0,40,0,0">
            <Label Text="Bingie"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#333333" />
            <Label Text="Track and overcome binge eating"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="#666666"
                   Margin="0,0,0,20" />
        </StackLayout>

        <!-- Login Form -->
        <Frame Grid.Row="1"
               BackgroundColor="White"
               CornerRadius="10"
               Margin="0,20"
               Padding="20"
               VerticalOptions="Center"
               HasShadow="True">
            <StackLayout Spacing="15">
                <Label Text="Sign In"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#333333"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10" />

                <Entry Placeholder="Username"
                       x:Name="UsernameEntry"
                       TextColor="#333333"
                       PlaceholderColor="#999999"
                       BackgroundColor="#f9f9f9"
                       Margin="0,5" />

                <Entry Placeholder="Password"
                       x:Name="PasswordEntry"
                       IsPassword="True"
                       TextColor="#333333"
                       PlaceholderColor="#999999"
                       BackgroundColor="#f9f9f9"
                       Margin="0,5" />

                <Grid ColumnDefinitions="Auto,*" Margin="0,5">
                    <CheckBox x:Name="RememberMeCheckBox" Grid.Column="0" />
                    <Label Text="Remember Me"
                           Grid.Column="1"
                           VerticalOptions="Center"
                           TextColor="#666666" />
                </Grid>

                <Button x:Name="LoginButton"
                        Text="Login"
                        Clicked="OnLoginClicked"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="5"
                        Margin="0,10,0,5" />

                <Button x:Name="RegisterButton"
                        Text="Register"
                        Clicked="OnRegisterClicked"
                        BackgroundColor="Transparent"
                        TextColor="#4CAF50"
                        BorderColor="#4CAF50"
                        BorderWidth="1"
                        CornerRadius="5" />

                <ActivityIndicator x:Name="ActivityIndicator"
                                   IsRunning="True"
                                   IsVisible="False"
                                   Color="#4CAF50"
                                   HorizontalOptions="Center"
                                   Margin="0,10,0,0" />
            </StackLayout>
        </Frame>

        <!-- Footer -->
        <Label Grid.Row="2"
               Text="© 2023 Bingie App"
               FontSize="12"
               TextColor="#999999"
               HorizontalOptions="Center"
               Margin="0,0,0,20" />
    </Grid>
</ContentPage>