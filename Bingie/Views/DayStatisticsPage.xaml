<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingie.Views.DayStatisticsPage"
             Title="Day Statistics">

    <StackLayout Padding="16" Spacing="16">

        <!-- Date Label -->
        <Label x:Name="SelectedDateLabel"
               FontSize="24"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               TextColor="Blue" />

        <!-- Binge Count Label -->
        <Label x:Name="BingeCountLabel"
               FontSize="20"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               TextColor="Red"
               Margin="0,20,0,0" />

        <!-- Entry List -->
        <CollectionView x:Name="EntriesCollectionView"
                        HeightRequest="200">
            <CollectionView.EmptyView>
                <Label Text="No entries recorded for this day."
                       HorizontalOptions="Center"
                       TextColor="#555555" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="0,4" CornerRadius="10" HasShadow="False" BackgroundColor="#F2F6FF">
                        <StackLayout>
                            <Label Text="{Binding DisplayTime}" FontAttributes="Bold" TextColor="#1F3A93"/>
                            <Label Text="{Binding FriendlyNote}" FontSize="13" TextColor="#555555"/>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Back Button -->
        <Button Text="Back to History"
                FontSize="18"
                HorizontalOptions="Center"
                VerticalOptions="CenterAndExpand"
                Clicked="OnBackButtonClicked" />

    </StackLayout>
</ContentPage>
