<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingie.Views.ExplorePage"
             Title="Explore">
    <Grid Padding="0">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#172A74" Offset="0" />
                <GradientStop Color="#21A9AF" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="24">
                <VerticalStackLayout x:Name="StoryGuideSection"
                                      Spacing="12"
                                      IsVisible="False">
                    <Label Text="Your weekly story episode"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Border StrokeThickness="0"
                            Padding="20"
                            BackgroundColor="#FFFFFF14"
                            StrokeShape="RoundRectangle 24">
                        <VerticalStackLayout Spacing="12">
                            <Label x:Name="StoryGuideWeekLabel"
                                   FontSize="14"
                                   TextColor="#E6F4FF" />

                            <VerticalStackLayout x:Name="StoryGuideTriggersLayout"
                                                 Spacing="8" />

                            <VerticalStackLayout x:Name="StoryGuideExperimentsLayout"
                                                 Spacing="12" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PointsSection"
                                      Spacing="14"
                                      IsVisible="False">
                    <Label Text="Glow meter"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <ProgressBar x:Name="PointsGlowProgress"
                                 HeightRequest="10"
                                 Progress="0"
                                 BackgroundColor="#FFFFFF1A"
                                 ProgressColor="#FFB347" />
                    <Label x:Name="PointsGlowLabel"
                           FontSize="14"
                           TextColor="#F2F8FF" />

                    <HorizontalStackLayout Spacing="10"
                                            VerticalOptions="Center">
                        <Label Text="Pause rewards"
                               FontSize="14"
                               TextColor="#F2F8FF"
                               VerticalOptions="Center" />
                        <Switch x:Name="PointsPauseSwitch"
                                Toggled="OnPointsPauseToggled" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Today’s quest board"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label x:Name="PointsQuestEmptyLabel"
                               IsVisible="False"
                               FontSize="14"
                               TextColor="#E6F4FF" />
                        <VerticalStackLayout x:Name="PointsQuestLayout"
                                             Spacing="10" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Weekly XP"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label x:Name="PointsWeeklyLabel"
                               FontSize="14"
                               TextColor="#E6F4FF" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Cosmetic unlocks"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <VerticalStackLayout x:Name="PointsCosmeticsLayout"
                                             Spacing="10" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Nourish your mind"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Tap into a library of loving reminders and mini challenges."
                           FontSize="18"
                           TextColor="#F2F8FF" />
                </VerticalStackLayout>

                <Border x:Name="QuoteCard"
                        StrokeThickness="0"
                        Padding="28"
                        BackgroundColor="#F9FBFF"
                        StrokeShape="RoundRectangle 28">
                    <Border.Shadow>
                        <Shadow Offset="10,10"
                                Radius="20"
                                Brush="#3B3B98"
                                Opacity="0.25" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label x:Name="QuoteTextLabel"
                               Text="“Keep going.”"
                               FontSize="22"
                               TextColor="#142850"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="QuoteAuthorLabel"
                               Text="- Anonymous"
                               FontSize="16"
                               TextColor="#527DA6"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Shuffle Inspiration"
                                Clicked="OnShuffleQuoteClicked"
                                CornerRadius="22"
                                BackgroundColor="#1B98E0"
                                TextColor="White"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Today’s playful challenges"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Pick one that feels doable and celebrate the attempt."
                           FontSize="16"
                           TextColor="#E6F4FF" />

                    <FlexLayout x:Name="ChallengesLayout"
                                Wrap="Wrap"
                                JustifyContent="SpaceAround"
                                AlignItems="Center"
                                AlignContent="Start"
                                Margin="0,8,0,0"
                                BindableLayout.ItemsSource="{x:Null}">
                    </FlexLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
