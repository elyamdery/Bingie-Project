<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingie.Views.StatisticsPage"
             Title="Detailed Statistics"
             BackgroundColor="#F8F9FA">    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Header with Back Button -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   HasShadow="True" 
                   Padding="15">
                <StackLayout>
                    <Grid ColumnDefinitions="Auto,*" 
                          Margin="0,0,0,10">
                        <Button x:Name="BackButton" 
                                Grid.Column="0"
                                Text="◀ Back" 
                                BackgroundColor="#E74C3C" 
                                TextColor="White" 
                                CornerRadius="15" 
                                FontSize="14"
                                Padding="15,8"
                                Clicked="OnBackClicked"/>
                        
                        <Label Text="📊 Statistics Overview" 
                               Grid.Column="1"
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="#2C3E50" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"/>
                    </Grid>
                </StackLayout>
            </Frame>
            
            <!-- Time Period Selector -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   HasShadow="True" 
                   Padding="15">
                <StackLayout>
                    <Label Text="Time Period" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="#2C3E50" 
                           HorizontalOptions="Center" 
                           Margin="0,0,0,15"/>
                    
                    <StackLayout Orientation="Horizontal"
                                 HorizontalOptions="Center" 
                                 Spacing="10">
                        <Button x:Name="WeekBtn" 
                                Text="Week" 
                                BackgroundColor="#3498DB" 
                                TextColor="White" 
                                CornerRadius="20" 
                                WidthRequest="80" 
                                HeightRequest="35" 
                                FontSize="14"
                                Clicked="OnWeekClicked"/>
                        <Button x:Name="MonthBtn" 
                                Text="Month" 
                                BackgroundColor="#95A5A6" 
                                TextColor="White" 
                                CornerRadius="20" 
                                WidthRequest="80" 
                                HeightRequest="35" 
                                FontSize="14"
                                Clicked="OnMonthClicked"/>
                        <Button x:Name="YearBtn" 
                                Text="Year" 
                                BackgroundColor="#95A5A6" 
                                TextColor="White" 
                                CornerRadius="20" 
                                WidthRequest="80" 
                                HeightRequest="35" 
                                FontSize="14"
                                Clicked="OnYearClicked"/>
                        <Button x:Name="AllTimeBtn" 
                                Text="All Time" 
                                BackgroundColor="#95A5A6" 
                                TextColor="White" 
                                CornerRadius="20" 
                                WidthRequest="80" 
                                HeightRequest="35" 
                                FontSize="14"
                                Clicked="OnAllTimeClicked"/>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Main Statistics -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   HasShadow="True" 
                   Padding="20">
                <Grid ColumnDefinitions="*,*" 
                      RowDefinitions="Auto,Auto,Auto,Auto" 
                      RowSpacing="20" 
                      ColumnSpacing="15">
                    
                    <!-- Total Binges -->
                    <Frame Grid.Row="0" Grid.Column="0" 
                           BackgroundColor="#E8F5E8" 
                           CornerRadius="12" 
                           Padding="15">
                        <StackLayout>
                            <Label x:Name="TotalBingesLabel" 
                                   Text="0" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   TextColor="#27AE60" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Total Binges" 
                                   FontSize="12" 
                                   TextColor="#7F8C8D" 
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                    
                    <!-- Daily Average -->
                    <Frame Grid.Row="0" Grid.Column="1" 
                           BackgroundColor="#FFF3E0" 
                           CornerRadius="12" 
                           Padding="15">
                        <StackLayout>
                            <Label x:Name="DailyAverageLabel" 
                                   Text="0.0" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   TextColor="#F39C12" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Daily Average" 
                                   FontSize="12" 
                                   TextColor="#7F8C8D" 
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                    
                    <!-- Good Days -->
                    <Frame Grid.Row="1" Grid.Column="0" 
                           BackgroundColor="#E3F2FD" 
                           CornerRadius="12" 
                           Padding="15">
                        <StackLayout>
                            <Label x:Name="GoodDaysLabel" 
                                   Text="0" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   TextColor="#3498DB" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Good Days (≤5)" 
                                   FontSize="12" 
                                   TextColor="#7F8C8D" 
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                    
                    <!-- Bad Days -->
                    <Frame Grid.Row="1" Grid.Column="1" 
                           BackgroundColor="#FFEBEE" 
                           CornerRadius="12" 
                           Padding="15">
                        <StackLayout>
                            <Label x:Name="BadDaysLabel" 
                                   Text="0" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   TextColor="#E74C3C" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Bad Days (>10)" 
                                   FontSize="12" 
                                   TextColor="#7F8C8D" 
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                    
                    <!-- Best Day -->
                    <Frame Grid.Row="2" Grid.Column="0" 
                           BackgroundColor="#F0F8FF" 
                           CornerRadius="12" 
                           Padding="15">
                        <StackLayout>
                            <Label x:Name="BestDayLabel" 
                                   Text="0" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   TextColor="#2980B9" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Best Day" 
                                   FontSize="12" 
                                   TextColor="#7F8C8D" 
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                    
                    <!-- Worst Day -->
                    <Frame Grid.Row="2" Grid.Column="1" 
                           BackgroundColor="#FDF2F8" 
                           CornerRadius="12" 
                           Padding="15">
                        <StackLayout>
                            <Label x:Name="WorstDayLabel" 
                                   Text="0" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   TextColor="#8E44AD" 
                                   HorizontalOptions="Center"/>
                            <Label Text="Worst Day" 
                                   FontSize="12" 
                                   TextColor="#7F8C8D" 
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                    
                    <!-- Current Streak -->
                    <Frame Grid.Row="3" Grid.ColumnSpan="2" 
                           BackgroundColor="#F5F5F5" 
                           CornerRadius="12" 
                           Padding="15">
                        <StackLayout>
                            <Label x:Name="CurrentStreakLabel" 
                                   Text="0 days" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="#34495E" 
                                   HorizontalOptions="Center"/>
                            <Label x:Name="StreakTypeLabel" 
                                   Text="Current Good Streak" 
                                   FontSize="14" 
                                   TextColor="#7F8C8D" 
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                </Grid>
            </Frame>

            <!-- Progress Chart Placeholder -->
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   HasShadow="True" 
                   Padding="20">
                <StackLayout>
                    <Label Text="📈 Progress Trends" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#2C3E50" 
                           Margin="0,0,0,15"/>
                    
                    <Label x:Name="TrendLabel" 
                           Text="Analyzing your progress..." 
                           FontSize="14" 
                           TextColor="#7F8C8D" 
                           HorizontalOptions="Center" 
                           Margin="0,20,0,20"/>
                    
                    <!-- Future: Add actual chart component here -->
                    <Frame BackgroundColor="#F8F9FA" 
                           CornerRadius="10" 
                           Padding="20" 
                           HeightRequest="150">
                        <Label Text="📊 Chart visualization coming soon!" 
                               FontSize="16" 
                               TextColor="#95A5A6" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"/>
                    </Frame>
                </StackLayout>
            </Frame>

            <!-- Time Period Label -->
            <Label x:Name="TimePeriodLabel" 
                   Text="Showing statistics for this week" 
                   FontSize="14" 
                   TextColor="#7F8C8D" 
                   HorizontalOptions="Center" 
                   Margin="0,10,0,0"/>

        </StackLayout>
    </ScrollView>
</ContentPage>