<?xml version="1.0" encoding="utf-8"?>

<!-- Views/Auth/LoginPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Bingie.Views.Auth.LoginPage"
             Title="Login">
    
    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            
            <!-- Header -->
            <Label Text="Welcome to Bingie" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   Margin="0,40,0,30" />
            
            <!-- Username Entry -->
            <StackLayout Spacing="5">
                <Label Text="Username" FontSize="16" />
                <Entry x:Name="UsernameEntry" 
                       Placeholder="Enter your username" />
            </StackLayout>
            
            <!-- Password Entry -->
            <StackLayout Spacing="5">
                <Label Text="Password" FontSize="16" />
                <Entry x:Name="PasswordEntry" 
                       Placeholder="Enter your password"
                       IsPassword="True" />
            </StackLayout>
            
            <!-- Remember Me -->
            <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,10">
                <CheckBox x:Name="RememberMeCheckBox" />
                <Label Text="Remember Me" VerticalOptions="Center" />
            </StackLayout>
            
            <!-- Login Button -->
            <Button x:Name="LoginButton"
                    Text="Login" 
                    Clicked="OnLoginClicked"
                    BackgroundColor="#007ACC"
                    TextColor="White"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,20,0,10" />
            
            <!-- Register Button -->
            <Button Text="Create New Account" 
                    Clicked="OnRegisterClicked"
                    BackgroundColor="Transparent"
                    TextColor="#007ACC"
                    BorderColor="#007ACC"
                    BorderWidth="1"
                    CornerRadius="5"
                    Padding="15" />
                    
        </StackLayout>
    </ScrollView>
</ContentPage>